---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/#projects', label: 'Projects', activeOn: '/' },
  { href: '/#process', label: 'Process', activeOn: '/' },
  { href: '/writing', label: 'Writing', activeOn: '/writing' },
  { href: '/#about', label: 'About', activeOn: '/' },
];
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="brand-lockup" aria-label="michelle.research home">
      <svg class="brand-mark" viewBox="0 0 104 84" aria-hidden="true" focusable="false">
        <path d="M0 84V0h26l24 37v26L24 33v51H0Z"></path>
        <path d="M104 84V0H78L54 37v26l26-30v51h24Z"></path>
      </svg>
      <span class="brand-divider" aria-hidden="true"></span>
      <span class="brand-wordmark">michelle<span>.</span>research</span>
    </a>

    <ul class="nav-links">
      {navLinks.map((link, index) => (
        <li>
          <a href={link.href} class:list={['nav-link', { active: pathname === link.activeOn && (link.activeOn !== '/' || index === 0) }]}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/contact" class="nav-cta">Let's Connect</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 84px;
    background: rgba(238, 233, 223, 0.96);
    border-bottom: 1px solid var(--mr-rule);
    backdrop-filter: blur(18px);
  }

  .site-nav {
    width: min(1408px, calc(100vw - 96px));
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--mr-heading);
    text-decoration: none;
  }

  .brand-lockup:hover {
    color: var(--mr-heading);
    text-decoration: none;
  }

  .brand-mark {
    width: 44px;
    height: auto;
    fill: currentColor;
    flex: 0 0 auto;
  }

  .brand-divider {
    width: 1px;
    height: 38px;
    background: rgba(63, 42, 82, 0.22);
  }

  .brand-wordmark {
    color: var(--mr-heading);
    font-family: var(--font-body);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
  }

  .brand-wordmark span {
    color: var(--mr-cta);
    margin: 0 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 52px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 84px;
    color: var(--mr-heading);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--mr-cta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-normal) var(--ease);
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link:hover {
    color: var(--mr-heading);
    text-decoration: none;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 164px;
    min-height: 44px;
    padding: 0 24px;
    border-radius: 2px;
    background: var(--mr-cta);
    color: #fff;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .nav-cta:hover {
    background: #8c4530;
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
  }

  @media (max-width: 920px) {
    .site-header {
      height: auto;
    }

    .site-nav {
      width: min(100% - 32px, 1408px);
      min-height: 76px;
      flex-wrap: wrap;
      gap: 16px 24px;
      padding: 14px 0;
    }

    .brand-divider {
      display: none;
    }

    .brand-wordmark {
      font-size: 19px;
    }

    .nav-links {
      order: 3;
      width: 100%;
      gap: 24px;
      overflow-x: auto;
    }

    .nav-link {
      height: 34px;
      font-size: 14px;
    }

    .nav-cta {
      min-width: auto;
      min-height: 38px;
      margin-left: auto;
      padding: 0 16px;
      font-size: 13px;
    }
  }
</style>
