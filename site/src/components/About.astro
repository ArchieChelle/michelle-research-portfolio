---
// Content placeholders — replace with your story before launch
const pullQuote = "Research isn't about answering questions. It's about asking the ones no one thought to ask yet.";

const story = [
  "I didn't start in research. I started with a question that wouldn't leave me alone — why do people use things that frustrate them, and what would it take to change that? That question eventually led me here: to a discipline where the whole job is figuring out what people actually need, not what they say they want.",
  "Over the past several years I've embedded with product and engineering teams at companies like NBCUniversal, SportsEngine, and GolfPass — bringing rigorous mixed-methods research into rooms where decisions were being made. I've run MaxDiff studies that moved roadmaps, facilitated vision workshops that turned executive disagreement into alignment, and built the kind of synthesis that gives leadership permission to commit.",
  "My research philosophy is simple: evidence should be qualified, quantified, and built to reach decision-makers — not just land in decks. I use AI as a thinking partner and a speed layer, but human judgment leads every insight call I make.",
];
---

<section class="about-section" aria-labelledby="about-heading">
  <div class="about-inner">
    <span class="section-label" id="about-heading">About</span>
    <div class="about-grid">
      <div class="about-quote-col">
        <blockquote class="about-quote">
          <p>"{pullQuote}"</p>
        </blockquote>
      </div>
      <div class="about-story-col">
        {story.map(paragraph => (
          <p class="about-paragraph">{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    border-top: 1px solid var(--mr-soft);
    padding: 96px 0;
  }

  .about-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 64px;
  }

  .section-label {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--mr-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 48px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 96px;
    align-items: start;
  }

  .about-quote {
    margin: 0;
    padding: 0;
  }

  .about-quote p {
    font-family: var(--font-display);
    font-size: 36px;
    font-style: italic;
    color: var(--mr-heading);
    line-height: 1.3;
    margin: 0;
  }

  .about-story-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-paragraph {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--mr-text);
    line-height: 1.7;
    margin: 0;
  }
</style>
