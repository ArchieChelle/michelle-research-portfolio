---
// exvia footer: black band, small tagline + stacked nav, giant wordmark.
const footerLinks = [
  { href: '/', label: 'HOME' },
  { href: '/process', label: 'SERVICES' },
  { href: '/about', label: 'ABOUT' },
  { href: '/contact', label: 'CONTACT' },
];
const year = new Date().getFullYear();
---

<footer class="x-footer">
  <div class="x-footer-top">
    <p class="x-footer-tagline">
      Human-centered research that helps product teams build with purpose and evidence.
    </p>
    <nav aria-label="Footer navigation">
      <ul class="x-footer-links">
        {footerLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <p class="x-footer-wordmark" aria-hidden="true">Michelle Exantus</p>
  <p class="sr-only">&copy; {year} Michelle Exantus</p>
</footer>

<style>
  .x-footer {
    display: flex;
    flex-direction: column;
    padding: 64px 24px 0;
    background: var(--x-bg-dark);
  }

  .x-footer-top {
    display: flex;
    justify-content: space-between;
    gap: 32px;
  }

  .x-footer-tagline {
    max-width: 240px;
    margin: 0;
    color: var(--x-on-dark-dim);
    font-family: var(--x-font-head);
    font-size: 14px;
    line-height: 1.5;
  }

  .x-footer-links {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: 0 15% 0 0;
    list-style: none;
  }

  .x-footer-links a {
    color: var(--x-on-dark);
    font-family: var(--x-font-mono);
    font-size: 12px;
    letter-spacing: .14em;
    line-height: 1;
    text-decoration: none;
  }

  .x-footer-links a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .x-footer-wordmark {
    margin: 72px 0 0;
    color: var(--x-on-dark);
    font-family: var(--x-font-head);
    font-size: clamp(44px, 9.4vw, 148px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    white-space: nowrap;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .x-footer {
      padding: 48px 16px 0;
    }

    .x-footer-links {
      padding-right: 0;
    }

    .x-footer-wordmark {
      margin-top: 48px;
      white-space: normal;
      font-size: clamp(36px, 13vw, 72px);
    }
  }
</style>
