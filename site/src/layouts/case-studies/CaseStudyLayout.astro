---
import Layout from '../../layouts/Layout.astro';
import ResearchTags from '../../components/ResearchTags.astro';

interface Props {
  entry: {
    data: {
      title: string;
      description: string;
      heroLabel: string;
      heroOutcome: string;
      timeline: string;
      client: string;
      methods: string[];
      researchApproach?: string;
      methodologyTags?: string[];
      role: string;
      sample: string;
      team: string;
      challenge: string[];
      approach: string[];
      findings: string[];
      dataAnalysis?: string[];
      impact?: string[];
      nextCta: { title: string; href: string; label: string };
    };
  };
}

const { entry } = Astro.props as Props;
const data = entry.data;
---

<Layout title={`${data.title} — Michelle Ruth Exantus`} description={data.description}>
  <main class="case-study-shell">
    <section class="hero">
      <p class="eyebrow">{data.heroLabel}</p>
      <h1>{data.title}</h1>
      <p class="description">{data.description}</p>
      <div class="cs-research-tags">
        <ResearchTags approach={data.researchApproach} tags={data.methodologyTags} />
      </div>
      <blockquote>{data.heroOutcome}</blockquote>
    </section>

    <section class="meta">
      <h2>At a glance</h2>
      <dl>
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        <div><dt>Client</dt><dd>{data.client}</dd></div>
        <div><dt>Timeline</dt><dd>{data.timeline}</dd></div>
        <div><dt>Methods</dt><dd>{data.methods.join(' · ')}</dd></div>
        <div><dt>Sample</dt><dd>{data.sample}</dd></div>
        <div><dt>Team</dt><dd>{data.team}</dd></div>
      </dl>
    </section>

    <section><h2>Challenge</h2><ul>{data.challenge.map((item) => <li>{item}</li>)}</ul></section>
    <section><h2>Approach</h2><ul>{data.approach.map((item) => <li>{item}</li>)}</ul></section>
    <section><h2>Findings</h2><ul>{data.findings.map((item) => <li>{item}</li>)}</ul></section>

    {data.dataAnalysis && data.dataAnalysis.length > 0 && (
      <section><h2>Data analysis</h2><ul>{data.dataAnalysis.map((item) => <li>{item}</li>)}</ul></section>
    )}

    <section>
      <h2>Impact</h2>
      {data.impact && data.impact.length > 0 ? <ul>{data.impact.map((item) => <li>{item}</li>)}</ul> : <p>Impact coming soon.</p>}
    </section>

    <section class="next-cta">
      <p>{data.nextCta.title}</p>
      <a href={data.nextCta.href}>{data.nextCta.label} →</a>
    </section>
  </main>
</Layout>

<style>
  .case-study-shell { width: min(980px, calc(100vw - 64px)); margin: 0 auto; padding: 136px 0 96px; color: var(--mr-heading); }
  section { padding: 28px 0; border-bottom: 1px solid var(--mr-soft); }
  .hero { padding-top: 0; }
  .eyebrow { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--mr-cta); margin: 0 0 12px; }
  h1 { font-size: clamp(42px, 5vw, 64px); line-height: 1.02; margin: 0 0 16px; }
  h2 { font-family: var(--font-body); font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--mr-cta); margin: 0 0 16px; }
  .description { max-width: 760px; margin: 0 0 18px; color: var(--mr-text); }
  .cs-research-tags {
    margin: 0 0 22px;
    --rt-font: var(--font-mono);
    --rt-approach-bg: var(--mr-heading);
    --rt-approach-fg: var(--mr-bg);
    --rt-method-fg: var(--mr-text);
    --rt-method-border: var(--mr-rule);
  }
  blockquote { margin: 0; padding-left: 20px; border-left: 3px solid var(--mr-soft); font-family: var(--font-display); font-style: italic; }
  dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 26px; margin: 0; }
  dt { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; color: var(--mr-cta); }
  dd { margin: 6px 0 0; color: var(--mr-text); }
  ul { margin: 0; padding-left: 20px; color: var(--mr-text); }
  li { margin: 10px 0; }
  .next-cta { border-bottom: 0; }
  .next-cta p { margin: 0 0 8px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; color: var(--mr-cta); }
  .next-cta a { font-size: 24px; color: var(--mr-heading); }
</style>
