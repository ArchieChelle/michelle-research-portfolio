    imageClass: 'crop-tax',
  },
];

const splitTitle = (title: string) => title.split(' ').map((word) => Array.from(word));

const approaches = [
  {
    letter: 'A',
    title: 'Mixed-Method UX Research',
    words: splitTitle('Mixed-Method UX Research'),
    pills: [
      { label: 'Survey Design', x: 14, y: 16, tone: 'cream' },
      { label: 'Generative Research', x: 42, y: 8, tone: 'soft' },
      { label: 'Evaluative Research', x: 68, y: 20, tone: 'ember' },
      { label: 'Stakeholder Interviewing', x: 24, y: 58, tone: 'gold' },
      { label: 'Usability Testing', x: 56, y: 70, tone: 'cream' },
      { label: 'Study Design', x: 76, y: 48, tone: 'soft' },
    ],
  },
  {
    letter: 'B',
    title: 'Product Strategy',
    words: splitTitle('Product Strategy'),
    pills: [
      { label: 'Roadmap Prioritization', x: 16, y: 18, tone: 'soft' },
      { label: 'Feature Scoring', x: 52, y: 10, tone: 'cream' },
      { label: 'Stakeholder Alignment', x: 34, y: 66, tone: 'ember' },
      { label: 'Competitive Analysis', x: 70, y: 54, tone: 'gold' },
    ],
  },
  {
    letter: 'C',
    title: 'CX Strategy & Service Design',
    words: splitTitle('CX Strategy & Service Design'),
    pills: [
      { label: 'Service Blueprinting', x: 12, y: 16, tone: 'cream' },
      { label: 'Workflow Redesign', x: 44, y: 8, tone: 'soft' },
      { label: 'Voice of Customer Programs', x: 60, y: 36, tone: 'ember' },
      { label: 'Experience Metrics', x: 20, y: 70, tone: 'gold' },
      { label: 'Outcome Measurement', x: 66, y: 74, tone: 'cream' },
    ],
  },
  {
    letter: 'D',
    title: 'Applied Research & Analytics',
    words: splitTitle('Applied Research & Analytics'),
    pills: [
      { label: 'Conjoint', x: 14, y: 18, tone: 'gold' },
      { label: 'Choice Modeling', x: 42, y: 8, tone: 'cream' },
      { label: 'Metrics Design', x: 68, y: 22, tone: 'soft' },
      { label: 'Insight Synthesis', x: 28, y: 68, tone: 'ember' },
      { label: 'Python', x: 72, y: 66, tone: 'gold' },
    ],
  },
];

const processSteps = [
  {
    number: '01',
    title: 'Discover',
    body: 'Understand the right problems through curiosity and empathy.',
    icon: 'search',
  },
  {
    number: '02',
    title: 'Synthesize',
    body: 'Turn complex data into clear, actionable insights.',
    icon: 'grid',
  },
  {
    number: '03',
    title: 'Strategize',
    body: 'Align on opportunities and define the right path forward.',
    icon: 'target',
  },
  {
    number: '04',
    title: 'Deliver',
    body: 'Communicate insights that drive decisions and impact.',
    icon: 'send',
  },
];

const articles = [
  {
    title: 'The Art of Asking Better Research Questions',
    date: 'Apr 22, 2024',
    read: '5 min read',
    imageClass: 'crop-writing-one',
  },
  {
    title: 'From Insight to Impact: Bridging Research and Product Decisions',
    date: 'Mar 10, 2024',
    read: '6 min read',
    imageClass: 'crop-writing-two',
  },
  {
    title: '5 Ways to Build a Research Culture in Your Team',
    date: 'Feb 19, 2024',
    read: '4 min read',
    imageClass: 'crop-writing-three',
