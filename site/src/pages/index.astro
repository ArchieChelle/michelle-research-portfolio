const companyLogos = [
  { name: 'SportsEngine HQ', label: 'sportsengine', sublabel: 'HQ', kind: 'two-line' },
  { name: 'SportsEngine Mobile', label: 'sportsengine', sublabel: 'MOBILE', kind: 'two-line' },
  { name: 'GolfPass', label: 'GOLFPASS', kind: 'wordmark' },
  { name: 'GolfNow', label: 'GOLFNOW', kind: 'wordmark' },
  { name: 'SportsNext', label: 'SPORTSNEXT', kind: 'wordmark wide' },
  { name: 'NBCUniversal', label: 'NBCUniversal', kind: 'serif' },
  { name: 'First Family Trust', label: 'FIRST FAMILY TRUST', kind: 'stacked' },
];

const marqueeSets = Array.from({ length: 4 });

const projects = [
  {
    title: 'Smart Scaling: Research to Drive Infrastructure User Experience',
    tag: 'Strategic research',
    read: '4 min read',
    imageClass: 'crop-smart',
  },
  {
    title: 'SE Play Tier-Feature Fit: Understanding What Matters Most',
    tag: 'Pricing research',
    read: '3 min read',
    imageClass: 'crop-seplay',
  },
  {
    title: 'Tax Intel Pro: Uncovering Opportunities for Platform Growth',
