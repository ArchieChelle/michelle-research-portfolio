<Layout
  title="michelle.research | UX Research Practice"
  description="Michelle Research helps product teams uncover human insight and build strategies that drive better decisions."
>
  <main class="landing-shell">
    <section class="hero" id="about" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">UX Researcher</p>
        <h1 id="hero-title">I design clarity into <em>complexity.</em></h1>
        <p>
          I partner with teams to uncover meaningful insights, align on opportunities,
          and create user experiences that drive impact.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="#projects">View Featured Work</a>
          <a class="text-link" href="#contact">Let's Connect <span>&rarr;</span></a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Editorial portrait composition">
        <div class="mockup-crop crop-portrait"></div>
      </div>
    </section>

    <section class="company-band" aria-labelledby="trusted-title">
      <p id="trusted-title">Trusted by research-led teams.</p>
      <div class="logo-marquee" aria-label="Companies worked with">
        <div class="logo-marquee-track">
          {marqueeSets.map((_, setIndex) => (
            <div class="logo-marquee-group" aria-hidden={setIndex > 0 ? 'true' : undefined}>
              {companyLogos.map((logo) => (
                <div class:list={['marquee-logo', logo.kind]} aria-label={setIndex === 0 ? logo.name : undefined}>
                  <span>{logo.label}</span>
                  {logo.sublabel && <small>{logo.sublabel}</small>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="portfolio-bento" id="projects" aria-labelledby="featured-title">
      <article class="featured-case">
        <div class="mockup-crop crop-featured"></div>
        <div class="featured-copy">
          <span class="tag">Featured Project</span>
          <h2 id="featured-title">Aligning Stakeholders and Prioritizing Mobile Roadmap Concepts</h2>
          <p>
            I led mixed-methods research to uncover user needs, evaluate 13 roadmap
            concepts, and align cross-functional stakeholders, narrowing to 5 high-impact investments.
          </p>
          <div class="meta-line">
            <span>5 min read</span>
            <span>Case Study</span>
            <a href="/projects/new-playbook" aria-label="Read featured case study">&rarr;</a>
          </div>
        </div>
      </article>

      <div class="project-stack">
        {projects.map((project) => (
          <article class="project-card">
            <div class:list={['mockup-crop', project.imageClass]}></div>
            <div class="project-copy">
              <span class="project-tag">{project.tag}</span>
              <h3>{project.title}</h3>
              <div class="meta-line">
                <span>{project.read}</span>
                <span>Case Study</span>
                <a href="/projects" aria-label={`View ${project.title}`}>&rarr;</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="approaches" aria-labelledby="approaches-title">
      <div class="approaches-header">
        <h2 id="approaches-title">Core Skills and Methodologies</h2>
        <p>How I turn research into actionable product decisions.</p>
      </div>
      <ul class="approach-list" aria-label="Research specialties">
        {approaches.map((approach) => (
          <li class="approach-item" tabindex="0" data-approach-item>
            <div class="approach-letter" aria-hidden="true">{approach.letter}</div>
            <h2 class="approach-title" aria-label={approach.title}>
              <span class="approach-title-inner" aria-hidden="true">
                {approach.words.map((word) => (
                  <span class="approach-word">
                    {word.map((char) => (
                      <span class="approach-char">{char}</span>
                    ))}
                  </span>
                ))}
              </span>
            </h2>
            <div class="pill-grid" aria-hidden="true">
              {approach.pills.map((pill) => (
                <span
                  class:list={['approach-pill', `tone-${pill.tone}`]}
                  style={`--pill-x: ${pill.x}%; --pill-y: ${pill.y}%;`}
                >
                  {pill.label}
                </span>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="process-section" id="process" aria-labelledby="process-title">
      <div class="section-header">
        <h2 id="process-title">My Process</h2>
        <p>From discovery to delivery, I turn ambiguity into evidence-backed direction.</p>
        <a class="text-link compact" href="/process">View Process <span>&rarr;</span></a>
      </div>
      <div class="process-grid">
        {processSteps.map((step) => (
          <article class="process-step">
            <div class="process-icon" aria-hidden="true">
              {step.icon === 'search' && (
                <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6"></circle><path d="m15 15 5 5"></path></svg>
              )}
              {step.icon === 'grid' && (
                <svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"></path></svg>
              )}
              {step.icon === 'target' && (
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"></circle><circle cx="12" cy="12" r="2"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path></svg>
              )}
              {step.icon === 'send' && (
                <svg viewBox="0 0 24 24"><path d="m3 11 18-8-8 18-2-8-8-2Z"></path><path d="m21 3-10 10"></path></svg>
              )}
            </div>
            <div>
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="writing-section" id="writing" aria-labelledby="writing-title">
      <div class="section-header">
        <h2 id="writing-title">Writing</h2>
        <p>Thoughts on research, strategy, and building better experiences.</p>
        <a class="text-link compact" href="/writing">View all articles <span>&rarr;</span></a>
      </div>
      <div class="writing-grid">
        {articles.map((article) => (
          <article class="article-card">
            <div class:list={['mockup-crop', article.imageClass]}></div>
            <div class="article-copy">
              <h3>{article.title}</h3>
              <div class="meta-line">
                <span>{article.date}</span>
                <span>{article.read}</span>
                <a href="/writing" aria-label={`Read ${article.title}`}>&rarr;</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="footer-cta" id="contact" aria-labelledby="contact-title">
      <div class="footer-title">
        <h2 id="contact-title">Let's build<br />what's next.</h2>
      </div>
      <div class="footer-action">
        <p>Now booking June research sprints.</p>
        <a class="button-primary" href="https://linkedin.com/in/exantusmich" target="_blank" rel="noreferrer">
          Say Hello <span>&rarr;</span>
        </a>
      </div>
      <div class="footer-social">
        <span>LinkedIn</span>
        <a href="https://linkedin.com/in/exantusmich" target="_blank" rel="noreferrer">linkedin.com/in/exantusmich</a>
      </div>
      <div class="footer-seal" aria-hidden="true">
        <svg viewBox="0 0 104 84">
          <path d="M0 84V0h26l24 37v26L24 33v51H0Z"></path>
          <path d="M104 84V0H78L54 37v26l26-30v51h24Z"></path>
        </svg>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  const canAnimateApproaches = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canAnimateApproaches && !reduceMotion) {
    const approachItems = document.querySelectorAll<HTMLElement>('[data-approach-item]');

    approachItems.forEach((item) => {
      const pills = Array.from(item.querySelectorAll<HTMLElement>('.approach-pill'));
      const chars = Array.from(item.querySelectorAll<HTMLElement>('.approach-char'));

      gsap.set(pills, {
        autoAlpha: 0,
        scale: 0,
        xPercent: -50,
        yPercent: -50,
      });

      const reveal = () => {
        gsap.killTweensOf([...pills, ...chars]);

        gsap.fromTo(
          chars,
          { yPercent: 18, autoAlpha: 0.38 },
          {
            yPercent: 0,
            autoAlpha: 1,
            duration: 0.42,
            stagger: 0.012,
            ease: 'power3.out',
            overwrite: true,
          }
        );

        gsap.to(pills, {
          autoAlpha: 1,
          scale: 1,
          x: () => gsap.utils.random(-8, 10),
          y: () => gsap.utils.random(-6, 7),
          duration: 0.36,
          stagger: 0.035,
          ease: 'back.out(1.7)',
          overwrite: true,
        });
      };

      const hide = () => {
        gsap.killTweensOf(pills);
        gsap.to(pills, {
          autoAlpha: 0,
          scale: 0,
          x: 0,
          y: 0,
          duration: 0.24,
          stagger: 0.018,
          ease: 'power2.in',
          overwrite: true,
        });
      };

      item.addEventListener('mouseenter', reveal);
      item.addEventListener('focusin', reveal);
      item.addEventListener('mouseleave', hide);
      item.addEventListener('focusout', hide);
    });
  }
</script>

<style>
  .landing-shell {
    width: min(1408px, calc(100vw - 96px));
    margin: 0 auto;
  }

  .hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
